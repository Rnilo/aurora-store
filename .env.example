# ============================================================
# Aurora Store - variables de entorno locales
# Copia este archivo como .env y ajusta lo que necesites.
# Nunca subas .env al repositorio.
# ============================================================

# Base de datos (PostgreSQL 16 en Docker)
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aurora_store
DB_HOST=db
DB_PORT=5433

# Backend
SECRETO_JWT=cambia-este-secreto-en-produccion
TOKEN_EXPIRA_MINUTOS=1440
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8080
LOG_LEVEL=INFO

# Redis (limite de tasa distribuido)
REDIS_PORT=6380
REDIS_URL=redis://redis:6379/0
LIMITE_TASA_HABILITADO=true
LIMITE_TASA_MAX_PETICIONES=120
LIMITE_TASA_VENTANA_SEGUNDOS=60
